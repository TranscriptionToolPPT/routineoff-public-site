","h2",null,{"children":"لماذا لا يكفي عدّ الملفات واحدًا واحدًا؟"}],[["$","p","نادراً ما يصل المشروع في ملف Word واحد ومنظم. قد يتضمن ملف PDF، وجداول Excel، وعروض PowerPoint، وصورًا مرجعية، وملف ZIP يحتوي على مجلدات إضافية. فتح كل عنصر على حدة يضيف وقتًا قبل بدء العمل الفعلي.",{"children":"نادراً ما يصل المشروع في ملف Word واحد ومنظم. قد يتضمن ملف PDF، وجداول Excel، وعروض PowerPoint، وصورًا مرجعية، وملف ZIP يحتوي على مجلدات إضافية. فتح كل عنصر على حدة يضيف وقتًا قبل بدء العمل الفعلي."}],"$Ld"],"$undefined",false]}],"$Le","$Lf","$L10"],"$L11"]}]]}],"$L12"]}],"$L13"]}]]
d:["$","p","المخاطرة لا تتعلق بالسرعة فقط. فقد يؤدي مرفق مخفي أو ملف ممسوح ضوئيًا أو إدخال يدوي مكرر إلى تغيير عرض السعر. لذلك يجب أن يحفظ سير عمل الدفعة نتيجة كل ملف إلى جانب الإجمالي الكلي.",{"children":"المخاطرة لا تتعلق بالسرعة فقط. فقد يؤدي مرفق مخفي أو ملف ممسوح ضوئيًا أو إدخال يدوي مكرر إلى تغيير عرض السعر. لذلك يجب أن يحفظ سير عمل الدفعة نتيجة كل ملف إلى جانب الإجمالي الكلي."}]
e:["$","section","workflow",{"id":"workflow","className":"_articleSection_jtxs5_213","children":[["$","p",null,{"className":"_eyebrow_jtxs5_114","children":"عملية قابلة للتكرار"}],["$","h2",null,{"children":"أربع خطوات من مجلد المشروع إلى إجمالي واضح"}],[["$","p","حافظ على بنية المشروع الأصلية، وعالج الدفعة كاملة، وراجع الاستثناءات قبل استخدام الإجمالي في عرض السعر أو السجلات الداخلية.",{"children":"حافظ على بنية المشروع الأصلية، وعالج الدفعة كاملة، وراجع الاستثناءات قبل استخدام الإجمالي في عرض السعر أو السجلات الداخلية."}]],["$","div",null,{"className":"_pointGrid_jtxs5_229","children":[["$","div","1. أضف الدفعة",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"1. أضف الدفعة"}],["$","p",null,{"children":"اختر الملفات أو مجلدًا كاملًا أو ملفات ZIP بدلًا من فتح المستندات واحدًا واحدًا."}]]}],["$","div","2. اختر الإعدادات",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"2. اختر الإعدادات"}],["$","p",null,{"children":"استخدم خيارات العد المناسبة، وفعّل OCR فقط للصور وملفات PDF الممسوحة التي تحتاج إليه."}]]}],["$","div","3. راجع الاستثناءات",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"3. راجع الاستثناءات"}],["$","p",null,{"children":"تحقق من حالة كل ملف وافحص أي عنصر يحتاج إلى الانتباه قبل اعتماد إجمالي الدفعة."}]]}],["$","div","4. صدّر النتيجة",{"children":[["$","span",null,{"children":"04"}],["$","h3",null,{"children":"4. صدّر النتيجة"}],["$","p",null,{"children":"أنشئ تقرير Excel منظمًا للمراجعة أو تجهيز عرض السعر أو حفظ سجلات المشروع."}]]}]]}],["$","div",null,{"className":"_rule_jtxs5_249","aria-hidden":"true"}]]}]
f:["$","section","formats",{"id":"formats","className":"_articleSection_jtxs5_213","children":[["$","p",null,{"className":"_eyebrow_jtxs5_114","children":"مدخلات متنوعة"}],["$","h2",null,{"children":"اجمع أنواع المستندات الشائعة في عملية واحدة"}],[["$","p","يدعم Word Count Tool ملفات PDF وWord وExcel وPowerPoint والملفات النصية والصور الشائعة وملفات ZIP، بما فيها الأرشيفات المتداخلة. والهدف هو تقليل عدد الأدوات المنفصلة المطلوبة قبل تسعير المشروع أو توزيعه.",{"children":"يدعم Word Count Tool ملفات PDF وWord وExcel وPowerPoint والملفات النصية والصور الشائعة وملفات ZIP، بما فيها الأرشيفات المتداخلة. والهدف هو تقليل عدد الأدوات المنفصلة المطلوبة قبل تسعير المشروع أو توزيعه."}],["$","p","دعم نوع الملف لا يعني أن كل مصدر له الدرجة نفسها من الدقة. فالمستندات الممسوحة تعتمد على جودة الصورة وOCR، ولذلك تظل نتائجها ظاهرة للمراجعة بدل اعتبار كل رقم مستخرج نتيجة مضمونة.",{"children":"دعم نوع الملف لا يعني أن كل مصدر له الدرجة نفسها من الدقة. فالمستندات الممسوحة تعتمد على جودة الصورة وOCR، ولذلك تظل نتائجها ظاهرة للمراجعة بدل اعتبار كل رقم مستخرج نتيجة مضمونة."}]],"$undefined",false]}]
10:["$","section","result",{"id":"result","className":"_articleSection_jtxs5_213","children":[["$","p",null,{"className":"_eyebrow_jtxs5_114","children":"المراجعة قبل الاستخدام"}],["$","h2",null,{"children":"اعتمد الإجمالي بعد التحقق من نتائج الملفات"}],[["$","p","العد المفيد للدفعات يجيب عن سؤالين: ما الإجمالي، وما الملفات التي كوّنته؟ تعرض مساحة العمل عدد الكلمات والحروف دون مسافات والوحدات المحسوبة ونتيجة كل ملف، حتى يستطيع الفريق اكتشاف أي نقص قبل إرسال عرض السعر.",{"children":"العد المفيد للدفعات يجيب عن سؤالين: ما الإجمالي، وما الملفات التي كوّنته؟ تعرض مساحة العمل عدد الكلمات والحروف دون مسافات والوحدات المحسوبة ونتيجة كل ملف، حتى يستطيع الفريق اكتشاف أي نقص قبل إرسال عرض السعر."}],["$","p","أثناء العد المعتاد، تتم معالجة محتوى المستندات محليًا على جهاز Windows. تدير خدمة الحساب تسجيل الدخول ومدة الصلاحية وهوية الجهاز وحالة الجلسة، ولا تستقبل المستندات الجاري عدّها.",{"children":"أثناء العد المعتاد، تتم معالجة محتوى المستندات محليًا على جهاز Windows. تدير خدمة الحساب تسجيل الدخول ومدة الصلاحية وهوية الجهاز وحالة الجلسة، ولا تستقبل المستندات الجاري عدّها."}]],"$undefined",false]}]
