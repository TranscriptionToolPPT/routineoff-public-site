c:["$","p","A supported file type does not make every source equally reliable. Scanned documents still depend on image quality and OCR, so the tool keeps those results visible for review rather than treating every extracted number as guaranteed.",{"children":"A supported file type does not make every source equally reliable. Scanned documents still depend on image quality and OCR, so the tool keeps those results visible for review rather than treating every extracted number as guaranteed."}]
d:["$","section","result",{"id":"result","className":"_articleSection_jtxs5_213","children":[["$","p",null,{"className":"_eyebrow_jtxs5_114","children":"Review before use"}],["$","h2",null,{"children":"Use the total only after checking the file-level result"}],[["$","p","A useful batch count answers two questions: what is the total, and which files produced it? The workspace shows words, characters without spaces, calculated units, and per-file results so the team can identify gaps before sending a quotation.",{"children":"A useful batch count answers two questions: what is the total, and which files produced it? The workspace shows words, characters without spaces, calculated units, and per-file results so the team can identify gaps before sending a quotation."}],["$","p","Document content is processed locally on the Windows computer during normal counting. The account service manages sign-in, expiry, device identity, and session status; it does not receive the documents being counted.",{"children":"Document content is processed locally on the Windows computer during normal counting. The account service manages sign-in, expiry, device identity, and session status; it does not receive the documents being counted."}]],"$undefined",false]}]
