c:["$","p","Word Count Tool retries difficult pages and marks uncertain or failed files for review. It is designed to make exceptions visible rather than silently presenting every result as reliable.",{"children":"Word Count Tool retries difficult pages and marks uncertain or failed files for review. It is designed to make exceptions visible rather than silently presenting every result as reliable."}]
d:["$","section","privacy",{"id":"privacy","className":"_articleSection_jtxs5_213","children":[["$","p",null,{"className":"_eyebrow_jtxs5_114","children":"Local document handling"}],["$","h2",null,{"children":"The document stays on the Windows computer during counting"}],[["$","p","During normal counting and OCR, document files and their content are processed locally and are not uploaded to RoutineOff's account server. Microsoft Word is used for official Word-document counting and for the final count in supported OCR workflows.",{"children":"During normal counting and OCR, document files and their content are processed locally and are not uploaded to RoutineOff's account server. Microsoft Word is used for official Word-document counting and for the final count in supported OCR workflows."}],["$","p","Internet access is used for sign-in and periodic account validation. This separation helps teams review sensitive document batches without sending the files to the access service.",{"children":"Internet access is used for sign-in and periodic account validation. This separation helps teams review sensitive document batches without sending the files to the access service."}]],"$undefined",false]}]
