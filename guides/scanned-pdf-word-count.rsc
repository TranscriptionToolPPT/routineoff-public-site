9:["$","article",null,{"className":"$undefined","children":[[["$","section","scanned-or-text",{"id":"scanned-or-text","className":"_articleSection_jtxs5_213","children":[["$","p",null,{"className":"_eyebrow_jtxs5_114","children":"Start with the source"}],["$","h2",null,{"children":"A PDF can contain text, page images, or both"}],[["$","p","A normal text PDF exposes its characters directly. A scanned PDF may only contain photographs of pages, even when it looks identical on screen. In that case, a word-count tool must use optical character recognition before it can estimate the text.",{"children":"A normal text PDF exposes its characters directly. A scanned PDF may only contain photographs of pages, even when it looks identical on screen. In that case, a word-count tool must use optical character recognition before it can estimate the text."}],["$","p","Mixed PDFs can contain selectable text on some pages and scans on others. That is why a zero or unusually low result should be treated as a review signal, not accepted automatically.",{"children":"Mixed PDFs can contain selectable text on some pages and scans on others. That is why a zero or unusually low result should be treated as a review signal, not accepted automatically."}]],"$undefined",false]}],["$","section","quality",{"id":"quality","className":"_articleSection_jtxs5_213","children":[["$","p",null,{"className":"_eyebrow_jtxs5_114","children":"OCR is not certainty"}],["$","h2",null,{"children":"Image quality, layout, and language affect the result"}],[["$","p","No OCR engine can guarantee perfect extraction from every scan. Rotation, low resolution, handwriting, stamps, tables, decorative backgrounds, and multiple columns can all change the output.",{"children":"No OCR engine can guarantee perfect extraction from every scan. Rotation, low resolution, handwriting, stamps, tables, decorative backgrounds, and multiple columns can all change the output."}]],["$","div",null,{"className":"_pointGrid_jtxs5_229","children":[["$","div","Clear scans",{"children":[["$","span",null,{"children":"01"}],["$","h3",null,{"children":"Clear scans"}],["$","p",null,{"children":"Straight, high-contrast pages generally produce a more reliable result than blurred phone photos."}]]}],["$","div","Complex layouts",{"children":[["$","span",null,{"children":"02"}],["$","h3",null,{"children":"Complex layouts"}],["$","p",null,{"children":"Tables, sidebars, headers, and multi-column documents may require a closer file-level review."}]]}],["$","div","Mixed languages",{"children":[["$","span",null,{"children":"03"}],["$","h3",null,{"children":"Mixed languages"}],["$","p",null,{"children":"Confirm that the relevant OCR language support is available for the documents in the batch."}]]}],["$","div","Warnings",{"children":[["$","span",null,{"children":"04"}],["$","h3",null,{"children":"Warnings"}],["$","p",null,{"children":"Treat uncertain or failed extraction as a prompt for manual checking, not as a final count."}]]}]]}],["$","div",null,{"className":"_rule_jtxs5_249","aria-hidden":"true"}]]}],["$","section","review",{"id":"review","className":"_articleSection_jtxs5_213","children":[["$","p",null,{"className":"_eyebrow_jtxs5_114","children":"A safer workflow"}],["$","h2",null,{"children":"Review exceptions before using the batch total"}],[["$","p","Run OCR only where it is needed, then compare the file status, page count, and extracted result with what you can see in the source. An empty scan, a very small number, or a warning deserves attention before the quotation is prepared.",{"children":"Run OCR only where it is needed, then compare the file status, page count, and extracted result with what you can see in the source. An empty scan, a very small number, or a warning deserves attention before the quotation is prepared."}],"$Lc"],"$undefined",false]}],"$Ld"],"$Le"]}]
