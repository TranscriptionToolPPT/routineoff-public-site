1:[[["$","link","css:/assets/index-DRrHkK7F.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-DRrHkK7F.css","data-rsc-css-href":"/assets/index-DRrHkK7F.css"}],"$undefined"],["$","main",null,{"className":"_page_rrnft_1","children":[["$","header",null,{"className":"_header_rrnft_8","children":[["$","$L6",null,{"className":"_brand_rrnft_18","href":"/","children":["Routine",["$","span",null,{"children":"Off"}]]}],["$","a",null,{"href":"/word-count-tool","children":"Word Count Tool"}]]}],["$","article",null,{"className":"_content_rrnft_36","children":[["$","h1",null,{"children":"Privacy Policy"}],["$","p",null,{"className":"_updated_rrnft_49","children":"Last updated: August 9, 2026"}],["$","p",null,{"className":"_notice_rrnft_76","children":"This policy explains how RoutineOff handles information when customers visit the website, purchase or manage a subscription, use Word Count Tool, or contact support."}],["$","section",null,{"children":[["$","h2",null,{"children":"Document processing"}],["$","p",null,{"children":"Word Count Tool processes selected document content locally on the user's Windows computer. Document contents are not uploaded to the account-control server as part of normal counting."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Account information"}],["$","p",null,{"children":"The access service may store a username, securely hashed password, account status, expiry date, device identifier, device name, application version, login timestamps, and session-control events. This information is used to provide access, prevent simultaneous use of one account on multiple devices, and allow administrators to revoke access."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Support requests"}],["$","p",null,{"children":"If a user submits a support request, we may receive the request text, optional screenshots, application version, Windows version, system architecture, device identifier, and relevant error details. The support flow does not send document names, document paths, document contents, extracted text, or full OCR results unless the user deliberately includes them in a support message or screenshot."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Payments"}],["$","p",null,{"children":"Stripe processes checkout, payment-card information, recurring charges, invoices, refunds, and the customer billing portal. RoutineOff does not receive or store complete card numbers or card security codes. We receive the Stripe customer and subscription identifiers, selected plan, billing contact, payment status, invoice and refund information needed to provide access, handle billing requests, prevent duplicate fulfilment, and meet record-keeping obligations. Stripe handles this information under its own privacy policy."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Website and communications"}],["$","p",null,{"children":"The website may receive standard technical information such as IP address, browser type, page request, and security logs from hosting and payment providers. If a customer emails us or requests a billing portal link, we process the supplied contact details and message to answer the request and protect account access."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Retention and security"}],["$","p",null,{"children":"Account and subscription information is retained while needed to provide the service and for a reasonable period afterwards to keep legally required records, resolve disputes, prevent abuse, and support customers. Support screenshots remain private and are retained with the support request according to the support retention process. Reasonable access controls, encrypted network connections, password hashing, private attachment storage, and backups are used, but no system can guarantee absolute security."}]]}],"$L7","$L8"]}],"$L9"]}]]
7:["$","section",null,{"children":[["$","h2",null,{"children":"Service providers and international processing"}],["$","p",null,{"children":"RoutineOff uses service providers for website hosting, access-server hosting, email delivery, software downloads, and payment processing. These providers process only the information required for their role and may operate in countries outside the customer's country. We select providers that offer appropriate security and contractual protections."}]]}]
8:["$","section",null,{"children":[["$","h2",null,{"children":"Your choices"}],["$","p",null,{"children":["Customers may request access, correction, or deletion of account information where applicable, and may object to or restrict certain processing where the law provides that right. Contact ",["$","a",null,{"href":"mailto:Mohamed95Hassan12@gmail.com","children":"Mohamed95Hassan12@gmail.com"}]," for privacy or account requests. We may retain limited records when required to provide the service, comply with law, resolve disputes, or protect the service from abuse."]}]]}]
