1:[[["$","link","css:/assets/index-OP-yYzLo.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-OP-yYzLo.css","data-rsc-css-href":"/assets/index-OP-yYzLo.css"}],"$undefined"],["$","$L8",null,{"english":["$","div",null,{"className":"_policyBlock_eqqkq_15","lang":"en","children":[["$","h1",null,{"children":"Cancellation & Refund Policy"}],["$","p",null,{"className":"_updated_eqqkq_24","children":"Last updated: August 19, 2026"}],["$","p",null,{"className":"_notice_eqqkq_32","children":"This policy applies to paid Word Count Tool subscriptions purchased through RoutineOff. The selected plan, billing frequency, applicable taxes, and total due are shown before payment. Monthly billing is currently available; annual billing applies only when offered at checkout."}],["$","section",null,{"children":[["$","h2",null,{"children":"Cancellation"}],["$","p",null,{"children":["Customers may cancel a subscription through the customer billing portal or by emailing ",["$","a",null,{"href":"mailto:info@routineoff.com","children":"info@routineoff.com"}],". Cancellation stops the next renewal; access normally continues until the end of the paid billing period. Cancellation does not create a pro-rated refund for time already paid for, except where required by applicable law."]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Billing issues"}],["$","p",null,{"children":"Duplicate charges, incorrect plan charges, and confirmed technical billing errors will be reviewed promptly. Contact support within 14 calendar days of noticing a billing issue and include the Stripe receipt or invoice number where available. This notice period does not limit mandatory rights under applicable law."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Refund requests"}],["$","p",null,{"children":["For the first payment of a new office subscription, the customer may request a refund within 7 calendar days if Word Count Tool cannot be installed or activated on a compatible system and RoutineOff support has not been able to resolve the issue. The request must be sent to ",["$","a",null,{"href":"mailto:info@routineoff.com","children":"info@routineoff.com"}]," with the office name, receipt or invoice number, device requirements, and a description of the problem. RoutineOff will normally confirm the decision within 5 business days. Approved refunds are submitted to Stripe within 10 business days after approval; the customer's bank may require additional time to post the funds. This policy does not limit mandatory consumer rights."]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Requests that are normally not refundable"}],["$","p",null,{"children":"Renewal periods already made available, unused time after cancellation, unsupported devices, missing required Microsoft Office components, or results affected by poor-quality documents are not normally refundable when the software and account operated as described. RoutineOff will still review duplicate charges, service failures, and rights provided by applicable law."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Digital delivery"}],["$","p",null,{"children":"Word Count Tool is a digital software product. After Stripe confirms payment, the business email used at checkout receives an Office Manager setup link, Office Code, plan details, subscription period, and the official download link. The Office Manager creates the licensed tool-user accounts and temporary passwords after completing setup; checkout does not email pre-created tool-user credentials. Delivery normally occurs within five minutes. If delivery has not arrived within 30 minutes, contact support and do not place a second order. No physical goods are shipped."}]]}],"$L9"]}],"arabic":"$La"}]]
9:["$","section",null,{"children":[["$","h2",null,{"children":"Failed or expired subscriptions"}],["$","p",null,{"children":"If renewal fails, the service normally provides a grace period of up to 3 calendar days before tool access is paused. Stripe may retry payment during this period. Restoring payment will reactivate the existing authorised users where possible."}]]}]
a:["$","div",null,{"className":"_policyBlock_eqqkq_15 _rtl_eqqkq_16","lang":"ar","dir":"rtl","children":[["$","h1",null,{"children":"سياسة الإلغاء والاسترجاع"}],["$","p",null,{"className":"_updated_eqqkq_24","children":"آخر تحديث: 19 أغسطس 2026"}],["$","p",null,{"className":"_notice_eqqkq_32","children":"تسري هذه السياسة على اشتراكات Word Count Tool المدفوعة والمشتراة من RoutineOff. تظهر الباقة المختارة ودورة الفوترة والضرائب المطبقة والإجمالي المستحق قبل الدفع. الفوترة الشهرية متاحة حاليًا، ولا تطبق الفوترة السنوية إلا عندما تكون معروضة في صفحة الدفع."}],["$","section",null,{"children":[["$","h2",null,{"children":"الإلغاء"}],["$","p",null,{"children":["يمكن للعميل إلغاء الاشتراك من بوابة الفوترة أو بإرسال رسالة إلى ",["$","a",null,{"href":"mailto:info@routineoff.com","children":"info@routineoff.com"}],". يوقف الإلغاء التجديد التالي، وعادة يستمر الوصول حتى نهاية فترة الفوترة المدفوعة. ولا ينشأ عن الإلغاء رد نسبي للمدة المدفوعة إلا عندما يوجب القانون المطبق ذلك."]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"مشكلات الفوترة"}],["$","p",null,{"children":"تُراجع بسرعة الخصومات المكررة ورسوم الباقة غير الصحيحة وأخطاء الفوترة التقنية المؤكدة. تواصل مع الدعم خلال 14 يومًا تقويميًا من ملاحظة المشكلة، وأرفق رقم إيصال Stripe أو الفاتورة إن توفر. ولا تحد هذه المهلة من الحقوق الإلزامية المقررة بالقانون."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"طلبات الاسترجاع"}],["$","p",null,{"children":["بالنسبة إلى أول دفعة لاشتراك مكتب جديد، يجوز للعميل طلب استرجاع خلال 7 أيام تقويمية إذا تعذر تثبيت Word Count Tool أو تفعيله على نظام متوافق ولم يتمكن دعم RoutineOff من حل المشكلة. يجب إرسال الطلب إلى ",["$","a",null,{"href":"mailto:info@routineoff.com","children":"info@routineoff.com"}]," مع اسم المكتب ورقم الإيصال أو الفاتورة ومتطلبات الجهاز ووصف المشكلة. عادة تؤكد RoutineOff القرار خلال 5 أيام عمل. وتُرسل مبالغ الاسترجاع المعتمدة إلى Stripe خلال 10 أيام عمل بعد الموافقة، وقد يحتاج بنك العميل وقتًا إضافيًا لإظهار المبلغ. ولا تحد هذه السياسة من حقوق المستهلك الإلزامية."]}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"الحالات غير القابلة للاسترجاع عادة"}],["$","p",null,{"children":"لا تكون فترات التجديد التي أُتيحت بالفعل، أو المدة غير المستخدمة بعد الإلغاء، أو الأجهزة غير المدعومة، أو نقص مكونات Microsoft Office المطلوبة، أو النتائج المتأثرة بسوء جودة المستندات قابلة للاسترجاع عادة عندما يعمل البرنامج والحساب كما هو موضح. ومع ذلك ستراجع RoutineOff الخصومات المكررة وتعطل الخدمة والحقوق التي يقررها القانون."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"التسليم الرقمي"}],["$","p",null,{"children":"Word Count Tool منتج برمجي رقمي. بعد تأكيد Stripe الدفع، يتلقى بريد العمل المستخدم عند الدفع رابط إعداد مدير المكتب ورمز المكتب وتفاصيل الباقة وفترة الاشتراك ورابط التحميل الرسمي. وينشئ مدير المكتب حسابات مستخدمي التول المرخصة وكلمات المرور المؤقتة بعد إكمال الإعداد؛ ولا ترسل صفحة الدفع بيانات دخول مستخدمين منشأة مسبقًا. عادة يتم التسليم خلال خمس دقائق. إذا لم يصل خلال 30 دقيقة، تواصل مع الدعم ولا تنفذ طلبًا ثانيًا. ولا تُشحن أي منتجات مادية."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"الاشتراكات المتعثرة أو المنتهية"}],["$","p",null,{"children":"إذا فشل التجديد، تمنح الخدمة عادة فترة سماح تصل إلى 3 أيام تقويمية قبل إيقاف الوصول إلى التول. وقد تعيد Stripe محاولة الدفع خلال هذه المدة. وتؤدي استعادة الدفع إلى إعادة تفعيل المستخدمين المخولين الحاليين حيثما أمكن."}]]}]]}]
