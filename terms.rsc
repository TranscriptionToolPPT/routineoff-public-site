1:[[["$","link","css:/assets/index-OP-yYzLo.css",{"rel":"stylesheet","precedence":"vite-rsc/importer-resources","href":"/assets/index-OP-yYzLo.css","data-rsc-css-href":"/assets/index-OP-yYzLo.css"}],"$undefined"],["$","$L7",null,{"english":["$","div",null,{"className":"_policyBlock_eqqkq_15","lang":"en","children":[["$","h1",null,{"children":"Terms of Use"}],["$","p",null,{"className":"_updated_eqqkq_24","children":"Last updated: August 19, 2026"}],["$","p",null,{"className":"_notice_eqqkq_32","children":"These terms apply to the Word Count Tool website, Windows software, office accounts, subscriptions, updates, and support services. By purchasing a plan or using an issued account, the customer accepts these terms."}],["$","p",null,{"children":["These Terms are between the customer and ","RoutineOff Technologies",", a ","sole establishment"," licensed by the ","Dubai Department of Economy and Tourism"," under Professional License No. ","1644355"," and Commercial Register No. ","2908233",". ","RoutineOff"," is the brand used to provide the Word Count Tool product and related services."]}],["$","section",null,{"children":[["$","h2",null,{"children":"The service"}],["$","p",null,{"children":"Word Count Tool is Windows desktop software designed to count supported documents, run OCR on eligible scanned content, present review information, and export results. It is delivered digitally through an official download page and requires an active tool account after installation."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Account access"}],["$","p",null,{"children":"Each tool username is intended for one authorised employee and one active device session at a time. The office owner is responsible for assigning accounts only to authorised staff. Users must protect credentials and may not resell, redistribute, reverse engineer, share access outside the subscribed office, or bypass account and device controls."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"OCR and count review"}],["$","p",null,{"children":"Results depend on document structure, scan quality, installed Microsoft Office components, and device performance. OCR output can contain errors. Customers are responsible for reviewing files marked for attention and verifying results before using them for billing, legal, or contractual decisions."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Availability and updates"}],["$","p",null,{"children":"The current release requires Windows 10 or Windows 11 (64-bit), a supported Microsoft Word desktop installation for Word-document counting and supported OCR workflows, and sufficient local storage and memory. Internet access is required for initial sign-in, periodic account validation, support, billing, and updates. After a successful validation, eligible active accounts may work offline for up to 24 hours. Document processing runs locally on the customer's computer. Features, supported formats, and technical requirements may change to improve reliability or security."}]]}],["$","section",null,{"children":[["$","h2",null,{"children":"Subscriptions and cancellation"}],["$","p",null,{"children":"The selected plan, included users, billing interval, price, and applicable taxes are presented before payment. Monthly billing is currently available; annual billing applies only when it is offered and configured at checkout. Stripe processes payment information and recurring charges. Subscriptions renew automatically at the selected interval on the date shown at checkout and on invoices until cancelled. Customers can cancel renewal through the secure billing portal or by contacting support. Cancellation stops future renewal and access normally continues until the end of the current paid period. A billing-interval change is applied at the end of the current billing period unless RoutineOff expressly confirms another arrangement. No pro-rated refund is created solely because a customer cancels before that date, except where required by law or stated in the Cancellation & Refund Policy."}]]}],"$L8","$L9","$La","$Lb","$Lc"]}],"arabic":"$Ld"}]]
